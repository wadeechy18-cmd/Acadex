ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://acadex:acadex@localhost:5432/acadex
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:3000

# Public URL of this API, used to build absolute links to locally-stored
# uploads (the frontend is a separate origin, so relative paths won't resolve).
PUBLIC_BASE_URL=http://localhost:8000

# Storage (local filesystem in dev; swap for S3-compatible provider in prod)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_ENDPOINT_URL=
