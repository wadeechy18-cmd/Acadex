{
  "stage": {
    "id": "ks1_y1",
    "name": "Key Stage 1 — Year 1",
    "age_range": "5-6",
    "framework_ref": "National Curriculum in England, DfE 2014",
    "subjects": [
      {
        "id": "ENG",
        "name": "English",
        "key_objectives": [
          {"obj_id": "ENG.R1", "strand": "Reading — word reading", "description": "Apply phonic knowledge to decode words (Phase 5/6), respond speedily with correct sound for graphemes, read words with common suffixes"},
          {"obj_id": "ENG.R2", "strand": "Reading — comprehension", "description": "Discuss significance of title/events, make inferences, predict, retell familiar stories, discuss word meanings"},
          {"obj_id": "ENG.W1", "strand": "Writing — transcription", "description": "Spell words containing 40+ phonemes taught, common exception words, name letters of the alphabet, write from memory simple sentences"},
          {"obj_id": "ENG.W2", "strand": "Writing — composition", "description": "Write sentences by saying aloud what they're going to write, sequence sentences to form short narratives, re-read to check sense"},
          {"obj_id": "ENG.W3", "strand": "Writing — vocabulary, grammar, punctuation", "description": "Join words/sentences using 'and', use capital letters, full stops, question marks, exclamation marks"},
          {"obj_id": "ENG.SL1", "strand": "Spoken language", "description": "Listen and respond appropriately, ask relevant questions, articulate and justify answers, participate in discussions"}
        ]
      },
      {
        "id": "MATHS",
        "name": "Mathematics",
        "key_objectives": [
          {"obj_id": "MATHS.N1", "strand": "Number — place value", "description": "Count to and across 100, read/write numbers to 20 in numerals and words, identify one more/one less"},
          {"obj_id": "MATHS.N2", "strand": "Number — addition and subtraction", "description": "Read/write/interpret mathematical statements using +, -, =, add/subtract one-digit and two-digit numbers to 20, solve missing number problems"},
          {"obj_id": "MATHS.N3", "strand": "Number — multiplication and division", "description": "Solve one-step problems involving multiplication/division using concrete objects, arrays, grouping and sharing"},
          {"obj_id": "MATHS.N4", "strand": "Number — fractions", "description": "Recognise, find and name a half and a quarter of an object, shape or quantity"},
          {"obj_id": "MATHS.MEA", "strand": "Measurement", "description": "Compare/describe length, mass, capacity, time; sequence events; recognise coins and notes; tell time to hour/half hour"},
          {"obj_id": "MATHS.GEO", "strand": "Geometry", "description": "Recognise and name common 2D and 3D shapes, describe position, direction and movement including half/quarter turns"}
        ]
      },
      {
        "id": "SCI",
        "name": "Science",
        "key_objectives": [
          {"obj_id": "SCI.MAT", "strand": "Everyday materials", "description": "Distinguish object from material, identify and name common materials, describe simple physical properties, compare materials"},
          {"obj_id": "SCI.ANI", "strand": "Animals including humans", "description": "Identify and name a variety of common animals, name parts of the human body, describe basic needs for survival"},
          {"obj_id": "SCI.SEA", "strand": "Seasonal changes", "description": "Observe changes across the four seasons, observe and describe weather associated with seasons and day length variation"},
          {"obj_id": "SCI.PLA", "strand": "Plants", "description": "Identify and name a variety of common wild and garden plants including deciduous/evergreen trees, identify basic structure of plants"}
        ]
      },
      {
        "id": "HIST",
        "name": "History",
        "key_objectives": [
          {"obj_id": "HIST.1", "strand": "Changes within living memory", "description": "Understand changes within living memory, revealing aspects of change in national life where appropriate"},
          {"obj_id": "HIST.2", "strand": "Significant individuals/events", "description": "Learn about events beyond living memory that are significant nationally/globally, and lives of significant individuals"}
        ]
      },
      {
        "id": "GEOG",
        "name": "Geography",
        "key_objectives": [
          {"obj_id": "GEOG.1", "strand": "Locational knowledge", "description": "Name and locate the world's continents and oceans, name/locate the four countries and capital cities of the UK"},
          {"obj_id": "GEOG.2", "strand": "Human and physical geography", "description": "Identify seasonal/daily weather patterns, use basic geographical vocabulary for human and physical features"}
        ]
      },
      {
        "id": "ART",
        "name": "Art and Design",
        "key_objectives": [
          {"obj_id": "ART.1", "strand": "Drawing, painting, sculpture", "description": "Use a range of materials to design and make products, develop techniques in drawing, painting and sculpture"},
          {"obj_id": "ART.2", "strand": "Learning about artists", "description": "Learn about the work of a range of artists, craft makers and designers, describing differences and similarities"}
        ]
      }
    ]
  },

